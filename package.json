{
  "name": "next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prebuild": "panda codegen && panda cssgen --silent",
    "prepare": "panda codegen && panda cssgen --silent",
    "dev": "nx run blog:dev-app",
    "dev:webpack": "nx run blog:dev-app -- --no-turbo",
    "build": "nx run blog:build-app",
    "start": "nx run blog:start-app",
    "lint": "nx run workspace:lint",
    "lint:admin": "nx run workspace:lint-admin",
    "test": "nx run workspace:e2e",
    "test:blog-status-bar": "bunx playwright test apps/blog/tests/blog-status-bar.spec.ts --config apps/blog/playwright.config.ts",
    "test:blog-spacing-contract": "bunx playwright test apps/blog/tests/blog-spacing-contract.spec.ts --config apps/blog/playwright.config.ts",
    "typecheck": "nx run workspace:typecheck",
    "ci": "nx run workspace:ci",
    "ci:automation": "nx run workspace:ci-automation",
    "vercel:login": "vercel login",
    "vercel:link": "vercel link",
    "vercel:pull": "vercel pull --yes",
    "vercel:pull:preview": "vercel pull --yes --environment=preview",
    "vercel:pull:prod": "vercel pull --yes --environment=production",
    "vercel:build": "vercel build",
    "vercel:build:prod": "vercel build --prod",
    "deploy:preview": "vercel build && vercel deploy --prebuilt",
    "deploy:prod": "vercel build --prod && vercel deploy --prebuilt --prod",
    "deploy": "bun run deploy:prod",
    "clean:vercel": "rm -rf .vercel/output",
    "public-proof:with-local-env": "dotenv -e .env.local --",
    "public-proof:db:generate": "nx run public-proof-db:generate",
    "public-proof:db:migrate": "nx run public-proof-db:migrate",
    "public-proof:db:migrate:local": "dotenv -e .env.local -- nx run public-proof-db:migrate",
    "public-proof:db:check": "nx run public-proof-db:check",
    "public-proof:db:check:local": "dotenv -e .env.local -- nx run public-proof-db:check",
    "public-proof:db:studio": "nx run public-proof-db:studio",
    "public-proof:db:studio:local": "dotenv -e .env.local -- nx run public-proof-db:studio",
    "public-proof:check": "nx run workspace:ci",
    "public-proof:cli:test": "nx run public-proof-cli:test",
    "public-proof:community-plan": "nx run public-proof-cli:community-plan",
    "public-proof:job-status": "nx run public-proof-cli:job-status",
    "public-proof:seed-demo": "dotenv -e .env.local -- bunx tsx packages/public-proof-db/scripts/seed-demo-sample.ts",
    "resume:build": "bun scripts/render-resume.mjs"
  },
  "dependencies": {
    "@apple/highlightjs-pkl": "^1.0.1",
    "@cursor/sdk": "^1.0.12",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-brands-svg-icons": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@mdx-js/loader": "^2.3.0",
    "@next/mdx": "^13.5.5",
    "@types/unist": "^3.0.3",
    "@vercel/analytics": "^1.6.1",
    "@xstate/react": "^6.0.0",
    "@zodyac/zod-mongoose": "^1.1.2",
    "framer-motion": "^12.29.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "jotai": "^2.12.5",
    "lowlight": "^3.3.0",
    "next-mdx-remote": "^6.0.0",
    "prism-themes": "^1.9.0",
    "public-proof-admin-core": "*",
    "public-proof-core": "*",
    "public-proof-db": "*",
    "public-proof-jobs": "*",
    "react-inlinesvg": "^4.2.0",
    "recharts": "^2.15.1",
    "rehype-highlight": "^7.0.2",
    "rehype-mdx-code-props": "^1.0.0",
    "rehype-prism-plus": "^2.0.1",
    "rehype-raw": "^7.0.0",
    "rxjs": "^7.8.2",
    "unist": "^0.0.1",
    "unist-util-visit": "^5.1.0",
    "vercel": "^54.0.0",
    "webpack": "^5.89.0",
    "xstate": "^5.24.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@nx/js": "22.7.2",
    "@nx/next": "^22.7.2",
    "@nx/playwright": "^22.7.2",
    "@pandacss/dev": "^1.6.1",
    "@playwright/test": "1.54.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.8.7",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.51.0",
    "eslint-config-next": "^14.1.4",
    "next": "^14.2.1",
    "npm-run-all": "^4.1.5",
    "nx": "^22.7.2",
    "puppeteer": "^23.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.21.0",
    "typescript": "*",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@playwright/test": "1.54.1",
    "playwright": "1.54.1",
    "playwright-core": "1.54.1"
  }
}
