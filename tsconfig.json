{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/styled-system/*": ["./styled-system/*"],
      "@/*": ["./apps/blog/*"]
    }
  },
  "include": [
    "apps/blog/next-env.d.ts",
    "apps/blog/**/*.ts",
    "apps/blog/**/*.tsx",
    "apps/blog/.next/types/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/automation/**/*.ts",
    "packages/automation/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "sat",
    "blog",
    "**/.next",
    ".nx"
  ],
  "references": []
}
